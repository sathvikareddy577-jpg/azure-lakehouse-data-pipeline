{
  "name": "pl_lakehouse_medallion",
  "properties": {
    "description": "Orchestrates Bronze, Silver/CDC, and Gold Databricks notebook stages.",
    "folder": {
      "name": "lakehouse"
    },
    "parameters": {
      "rawDataPath": {
        "type": "String"
      },
      "warehousePath": {
        "type": "String"
      },
      "cdcPath": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "Run Bronze",
        "type": "DatabricksNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookPath": "/Repos/<user>/azure-lakehouse-data-pipeline/azure/databricks/notebook_main",
          "baseParameters": {
            "stage": "bronze",
            "raw_data_path": {
              "type": "Expression",
              "value": "@pipeline().parameters.rawDataPath"
            },
            "warehouse_path": {
              "type": "Expression",
              "value": "@pipeline().parameters.warehousePath"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "DatabricksLinkedService",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Run Silver and CDC",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Run Bronze",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookPath": "/Repos/<user>/azure-lakehouse-data-pipeline/azure/databricks/notebook_main",
          "baseParameters": {
            "stage": "silver",
            "warehouse_path": {
              "type": "Expression",
              "value": "@pipeline().parameters.warehousePath"
            },
            "cdc_path": {
              "type": "Expression",
              "value": "@pipeline().parameters.cdcPath"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "DatabricksLinkedService",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Run Gold",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Run Silver and CDC",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookPath": "/Repos/<user>/azure-lakehouse-data-pipeline/azure/databricks/notebook_main",
          "baseParameters": {
            "stage": "gold",
            "warehouse_path": {
              "type": "Expression",
              "value": "@pipeline().parameters.warehousePath"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "DatabricksLinkedService",
          "type": "LinkedServiceReference"
        }
      }
    ],
    "annotations": [
      "medallion",
      "databricks",
      "managed-identity"
    ]
  }
}
