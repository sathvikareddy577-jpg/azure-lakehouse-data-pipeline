{
  "name": "azure-lakehouse-medallion",
  "description": "Multi-task Azure Databricks workflow for Bronze, Silver/CDC, and Gold.",
  "max_concurrent_runs": 1,
  "job_clusters": [
    {
      "job_cluster_key": "lakehouse_job_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "autoscale": {
          "min_workers": 1,
          "max_workers": 4
        },
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        },
        "data_security_mode": "SINGLE_USER"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "job_cluster_key": "lakehouse_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/<user>/azure-lakehouse-data-pipeline/azure/databricks/notebook_main",
        "base_parameters": {
          "stage": "bronze"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver",
      "depends_on": [
        {
          "task_key": "bronze"
        }
      ],
      "job_cluster_key": "lakehouse_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/<user>/azure-lakehouse-data-pipeline/azure/databricks/notebook_main",
        "base_parameters": {
          "stage": "silver"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "gold",
      "depends_on": [
        {
          "task_key": "silver"
        }
      ],
      "job_cluster_key": "lakehouse_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/<user>/azure-lakehouse-data-pipeline/azure/databricks/notebook_main",
        "base_parameters": {
          "stage": "gold"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "tags": {
    "environment": "portfolio",
    "project": "azure-lakehouse"
  }
}
