{
  "name": "lakehouse-pipeline-job",
  "description": "Azure Lakehouse Data Pipeline - Production Job",
  "new_cluster": {
    "spark_version": "11.3.x-scala2.12",
    "node_type_id": "Standard_DS4_v2",
    "num_workers": 2,
    "aws_attributes": {
      "availability": "SPOT"
    },
    "init_scripts": [
      {
        "dbfs": {
          "destination": "dbfs:/init-scripts/install-packages.sh"
        }
      }
    ]
  },
  "spark_python_task": {
    "python_file": "abfss://scripts@lakehousedata.dfs.core.windows.net/run_pipeline.py",
    "parameters": ["--layer", "full"]
  },
  "timeout_seconds": 3600,
  "max_retries": 1,
  "email_notifications": {},
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC"
  },
  "tags": {
    "environment": "production",
    "project": "lakehouse"
  }
}
