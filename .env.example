# Environment variables template
# Copy to .env and fill in with your values

# Data paths
DATA_PATH=data/raw
WAREHOUSE_PATH=data/warehouse

# Spark settings
SPARK_APP_NAME=lakehouse-pipeline
SPARK_MASTER=local[*]

# Azure ADLS Gen2 (for deployment)
ADLS_STORAGE_ACCOUNT=lakehousedata
# Databricks workspace (authentication should use Azure CLI/managed identity)
DATABRICKS_HOST=https://your-databricks-instance.azuredatabricks.net

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# Quality thresholds
MAX_NULL_RATIO=0.05
DUPLICATE_THRESHOLD=0.02

# Never commit secrets or credentials to version control.
